-- ESP：紅色輪廓、玩家名稱與距離
--==================================================

local espObjects = {}
local espCharacterConnections = {}
local espPlayerAddedConnection
local espPlayerRemovingConnection

local function removeESP(targetPlayer)
    local objects = espObjects[targetPlayer]

    if objects then
        if objects.highlight then
            objects.highlight:Destroy()
        end

        if objects.billboard then
            objects.billboard:Destroy()
        end

        espObjects[targetPlayer] = nil
    end
end

local function createESP(targetPlayer, character)
    if not espEnabled or closed or targetPlayer == player then
        return
    end

    removeESP(targetPlayer)

    if not character or not character.Parent then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not head or not root then
        task.spawn(function()
            local readyHead = character:WaitForChild("Head", 8)
            local readyRoot = character:WaitForChild("HumanoidRootPart", 8)
            local readyHumanoid = character:FindFirstChildOfClass("Humanoid")

            if espEnabled and not closed
                and readyHead and readyRoot and readyHumanoid then
                createESP(targetPlayer, character)
            end
        end)

        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "HarryHubESPHighlight"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 1
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "HarryHubESPLabel"
    billboard.Adornee = head
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(260, 30)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
    billboard.MaxDistance = 100000
    billboard.Parent = character

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "PlayerInfo"
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    textLabel.TextStrokeTransparency = 0.15
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.TextScaled = false
    textLabel.Text = targetPlayer.Name .. " [-- m]"
    textLabel.Parent = billboard

    espObjects[targetPlayer] = {
        highlight = highlight,
        billboard = billboard,
        textLabel = textLabel,
        character = character,
        lastDistance = nil
    }
end

local function watchPlayer(targetPlayer)
    if targetPlayer == player then return end

    if espCharacterConnections[targetPlayer] then
        espCharacterConnections[targetPlayer]:Disconnect()
        espCharacterConnections[targetPlayer] = nil
    end

    espCharacterConnections[targetPlayer] =
        targetPlayer.CharacterAdded:Connect(function(character)
            if espEnabled then
                task.defer(function()
                    createESP(targetPlayer, character)
                end)
            end
        end)

    if espEnabled and targetPlayer.Character then
        createESP(targetPlayer, targetPlayer.Character)
    end
end

local function setESP(enabled)
    espEnabled = enabled

    if not enabled then
        for targetPlayer in pairs(espObjects) do
            removeESP(targetPlayer)
        end

        espToggle.Text = "ESP：已關閉"
        espToggle.BackgroundColor3 = Color3.fromRGB(42, 42, 46)
        return
    end

    espToggle.Text = "ESP：已開啟"
    espToggle.BackgroundColor3 = Color3.fromRGB(150, 25, 35)

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        watchPlayer(targetPlayer)
    end
end

espToggle.Activated:Connect(function()
    setESP(not espEnabled)
end)

espPlayerAddedConnection = Players.PlayerAdded:Connect(function(targetPlayer)
