-- ESP
--==================================================

local function removeESP(targetPlayer)
    local objects = espObjects[targetPlayer]
    if not objects then return end

    if objects.highlight then objects.highlight:Destroy() end
    if objects.billboard then objects.billboard:Destroy() end
    espObjects[targetPlayer] = nil
end

local function createESP(targetPlayer, character)
    if not espEnabled or closed or targetPlayer == player then return end
    removeESP(targetPlayer)

    if not character or not character.Parent then return end

    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not head or not root or not humanoid then
        task.spawn(function()
            head = character:WaitForChild("Head", 8)
            root = character:WaitForChild("HumanoidRootPart", 8)
            humanoid = character:FindFirstChildOfClass("Humanoid")
            if espEnabled and not closed and head and root and humanoid then
                createESP(targetPlayer, character)
            end
        end)
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "HarryHubESPHighlight"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 1
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "HarryHubESPLabel"
    billboard.Adornee = head
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(260, 30)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
    billboard.MaxDistance = 100000
    billboard.Parent = character

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    textLabel.TextStrokeTransparency = 0.15
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.Text = targetPlayer.Name .. " [-- studs]"
    textLabel.Parent = billboard

    espObjects[targetPlayer] = {
        highlight = highlight,
        billboard = billboard,
        textLabel = textLabel,
        character = character,
    }
end

local function setESP(enabled)
    espEnabled = enabled

    if not enabled then
        for targetPlayer in pairs(espObjects) do
            removeESP(targetPlayer)
        end
        espToggle.Text = "ESP：已關閉"
        espToggle.BackgroundColor3 = inactiveColor
        return
    end

    espToggle.Text = "ESP：已開啟"
    espToggle.BackgroundColor3 = activeColor

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and targetPlayer.Character then
            createESP(targetPlayer, targetPlayer.Character)
        end
    end
end

track(espToggle.Activated:Connect(function()
    setESP(not espEnabled)
end))

track(Players.PlayerAdded:Connect(function(targetPlayer)
    track(targetPlayer.CharacterAdded:Connect(function(character)
        if espEnabled then
            task.defer(createESP, targetPlayer, character)
        end
    end))
end))

track(Players.PlayerRemoving:Connect(function(targetPlayer)
    removeESP(targetPlayer)
end))

for _, targetPlayer in ipairs(Players:GetPlayers()) do
    if targetPlayer ~= player then
        track(targetPlayer.CharacterAdded:Connect(function(character)
            if espEnabled then
                task.defer(createESP, targetPlayer, character)
            end
        end))
    end
end

track(RunService.Heartbeat:Connect(function()
    if closed or not espEnabled then return end

    local _, _, myRoot = getCharacterParts()
    if not myRoot then return end

    for targetPlayer, objects in pairs(espObjects) do
        local targetCharacter = targetPlayer.Character
        local targetRoot = targetCharacter
            and targetCharacter:FindFirstChild("HumanoidRootPart")

        if targetCharacter and targetCharacter ~= objects.character then
            createESP(targetPlayer, targetCharacter)
        elseif targetRoot and objects.textLabel then
            local distance = math.floor(
                (myRoot.Position - targetRoot.Position).Magnitude + 0.5
            )
            objects.textLabel.Text =
                targetPlayer.Name .. " [" .. distance .. " studs]"
        end
    end
end))

