local function parseSpeed(box, status, label)
    local n = tonumber(box.Text)
    if not n or n < 1 or n > 100000 or n % 1 ~= 0 then
        status.Text = "請輸入 1～100000 的整數"
        return nil
    end
    status.Text = label .. "：" .. n
    return n
end

track(walkApply.Activated:Connect(function()
    local n = parseSpeed(walkBox, walkStatus, "目前移動速度")
    if not n then return end

    walkSpeed = n
    local _, humanoid = getCharacterParts()
    if humanoid then humanoid.WalkSpeed = n end
end))

track(flyApply.Activated:Connect(function()
    local n = parseSpeed(flyBox, flyStatus, "目前飛行速度")
    if n then flySpeed = n end
end))

--==================================================
-- 飛行
--==================================================

local function stopFlying()
    flying = false

    if flightConnection then
        flightConnection:Disconnect()
        flightConnection = nil
    end

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if flightHumanoid and flightHumanoid.Parent then
        if oldPlatformStand ~= nil then
            flightHumanoid.PlatformStand = oldPlatformStand
        end
        if oldAutoRotate ~= nil then
            flightHumanoid.AutoRotate = oldAutoRotate
        end
    end

    if flightRoot and flightRoot.Parent then
        flightRoot.AssemblyLinearVelocity = Vector3.zero
        flightRoot.AssemblyAngularVelocity = Vector3.zero
    end

    flightHumanoid, flightRoot = nil, nil
    flyToggle.Text = "飛行：已關閉"
    flyToggle.BackgroundColor3 = inactiveColor
end

local function startFlying()
    local _, humanoid, root = getCharacterParts()
    if not humanoid or not root then
        flyStatus.Text = "找不到角色，請重新嘗試"
        return
    end

    flightHumanoid, flightRoot = humanoid, root
    oldAutoRotate = humanoid.AutoRotate
    oldPlatformStand = humanoid.PlatformStand

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "HarryHubFlightVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.P = 1e5
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = root

    flying = true
    flyToggle.Text = "飛行：已開啟"
    flyToggle.BackgroundColor3 = activeColor

    flightConnection = RunService.Heartbeat:Connect(function()
        if closed or not flying or not root.Parent
            or not bodyVelocity then
            stopFlying()
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        local cf = camera.CFrame
        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += cf.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= cf.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += cf.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= cf.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        bodyVelocity.Velocity = direction * flySpeed

        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if look.Magnitude > 0.001 then
            root.CFrame = CFrame.lookAt(
                root.Position, root.Position + look.Unit
            )
        end
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

track(flyToggle.Activated:Connect(function()
    if flying then stopFlying() else startFlying() end
end))

--==================================================
-- 穿牆
--==================================================

local function applyNoclipToPart(character, part)
    if not noclipEnabled or not part:IsA("BasePart") then return end

    oldCollisions[character] = oldCollisions[character] or {}
    local saved = oldCollisions[character]

    if saved[part] == nil then
        saved[part] = part.CanCollide
    end

    part.CanCollide = false
end

local function restoreAllCollisions()
    for character, saved in pairs(oldCollisions) do
        for part, original in pairs(saved) do
            if part and part.Parent then
                part.CanCollide = original
            end
        end
        oldCollisions[character] = nil
    end
end

local function setNoclip(enabled)
    noclipEnabled = enabled

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end

    if not enabled then
        restoreAllCollisions()
        noclipToggle.Text = "穿牆：已關閉"
        noclipToggle.BackgroundColor3 = inactiveColor
        return
    end

    noclipToggle.Text = "穿牆：已開啟"
    noclipToggle.BackgroundColor3 = activeColor

    local function watchCharacter(character)
        for _, part in ipairs(character:GetDescendants()) do
            applyNoclipToPart(character, part)
        end

        if noclipDescendantConnection then
            noclipDescendantConnection:Disconnect()
        end

        noclipDescendantConnection = character.DescendantAdded:Connect(
            function(part)
                applyNoclipToPart(character, part)
            end
        )
    end

    if player.Character then
        watchCharacter(player.Character)
    end

    noclipConnection = RunService.Stepped:Connect(function()
        if closed or not noclipEnabled then return end
        local character = player.Character
        if not character then return end

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                applyNoclipToPart(character, part)
            end
        end
    end)
end

track(noclipToggle.Activated:Connect(function()
    setNoclip(not noclipEnabled)
end))

