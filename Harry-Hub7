espPlayerRemovingConnection = Players.PlayerRemoving:Connect(function(targetPlayer)
    removeESP(targetPlayer)

    if espCharacterConnections[targetPlayer] then
        espCharacterConnections[targetPlayer]:Disconnect()
        espCharacterConnections[targetPlayer] = nil
    end
end)

for _, targetPlayer in ipairs(Players:GetPlayers()) do
    if targetPlayer ~= player then
        watchPlayer(targetPlayer)
    end
end

local distanceAccumulator = 0

local espUpdateConnection = RunService.Heartbeat:Connect(function(dt)
    if closed or not espEnabled then return end

    distanceAccumulator += dt
    if distanceAccumulator < 0.1 then return end
    distanceAccumulator = 0

    local myCharacter = player.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for targetPlayer, objects in pairs(espObjects) do
        local targetCharacter = targetPlayer.Character
        local targetRoot = targetCharacter
            and targetCharacter:FindFirstChild("HumanoidRootPart")

        if not targetCharacter
            or targetCharacter ~= objects.character
            or not targetRoot
            or not objects.textLabel
            or not objects.textLabel.Parent then

            if targetCharacter and targetCharacter ~= objects.character then
                createESP(targetPlayer, targetCharacter)
            end
        else
            local distance = (myRoot.Position - targetRoot.Position).Magnitude
            local roundedDistance = math.floor(distance + 0.5)

            if objects.lastDistance ~= roundedDistance then
                objects.lastDistance = roundedDistance
                objects.textLabel.Text =
                    targetPlayer.Name .. " [" .. roundedDistance .. " m]"
            end
        end
    end
end)

