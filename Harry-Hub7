-- 判斷滑鼠是否位於 Harry Hub 介面上
local function mouseOverHub()
    local mousePos = UIS:GetMouseLocation()

    -- 使用 PlayerGui 查詢滑鼠位置上的 GUI 元件
    local objects = playerGui:GetGuiObjectsAtPosition(
        mousePos.X,
        mousePos.Y
    )

    for _, object in ipairs(objects) do
        if object:IsDescendantOf(gui) then
            return true
        end
    end

    return false
end

-- 選擇螢幕中心最近、且在畫面內的其他玩家
local function findLockTarget()
    local camera = Workspace.CurrentCamera
    if not camera then return nil end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local bestPlayer = nil
    local bestDistance = math.huge

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local screenPoint, onScreen =
                    camera:WorldToViewportPoint(head.Position)

                if onScreen and screenPoint.Z > 0 then
                    local point = Vector2.new(
                        screenPoint.X,
                        screenPoint.Y
                    )

                    local distanceFromCenter = (point - center).Magnitude

                    if distanceFromCenter < bestDistance then
                        bestDistance = distanceFromCenter
                        bestPlayer = targetPlayer
                    end
                end
            end
        end
    end

    return bestPlayer
end

UIS.InputBegan:Connect(function(input, gameProcessed)
    if closed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if UIS:GetFocusedTextBox() then return end

        if not gameProcessed and input.KeyCode == lockHotkey then
            setLockEnabled(not lockEnabled)
        end

        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if lockEnabled and not mouseOverHub() then
            leftHeld = true
            lockedTarget = findLockTarget()
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        leftHeld = false
        lockedTarget = nil
    end
end)

local lockRenderName = "HarryHub_LockCamera_" .. player.UserId

RunService:BindToRenderStep(
    lockRenderName,
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if closed or not lockEnabled or not leftHeld then return end
        if mouseOverHub() then return end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        local character = lockedTarget and lockedTarget.Character
        local head = character and character:FindFirstChild("Head")
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if not head or not humanoid or humanoid.Health <= 0 then
            lockedTarget = findLockTarget()

            character = lockedTarget and lockedTarget.Character
            head = character and character:FindFirstChild("Head")
            humanoid = character
                and character:FindFirstChildOfClass("Humanoid")
        end

        if head and humanoid and humanoid.Health > 0 then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                head.Position
            )
        end
    end
)

