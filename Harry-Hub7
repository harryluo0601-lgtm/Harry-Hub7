track(player.CharacterAdded:Connect(function(character)
    if flying then stopFlying() end

    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)
        if humanoid and not closed then
            humanoid.WalkSpeed = walkSpeed
        end

        if noclipEnabled and not closed then
            for _, part in ipairs(character:GetDescendants()) do
                applyNoclipToPart(character, part)
            end
            if noclipDescendantConnection then
                noclipDescendantConnection:Disconnect()
            end
            noclipDescendantConnection = character.DescendantAdded:Connect(
                function(part)
                    applyNoclipToPart(character, part)
                end
            )
        end

        if espEnabled and not closed then
            task.defer(function()
                for _, targetPlayer in ipairs(Players:GetPlayers()) do
                    if targetPlayer ~= player and targetPlayer.Character then
                        createESP(targetPlayer, targetPlayer.Character)
                    end
                end
            end)
        end
    end)
end))

