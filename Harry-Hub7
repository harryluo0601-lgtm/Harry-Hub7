-- 左鍵傳送：開關控制，不使用額外快捷鍵
--==================================================

local mouse = player:GetMouse()

track(teleportToggle.Activated:Connect(function()
    teleportEnabled = not teleportEnabled
    teleportToggle.Text = teleportEnabled
        and "左鍵傳送：已開啟"
        or "左鍵傳送：已關閉"
    teleportToggle.BackgroundColor3 = teleportEnabled
        and activeColor
        or inactiveColor
end))

track(UIS.InputBegan:Connect(function(input, processed)
    if closed or not teleportEnabled or processed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    -- 不要在點擊 Hub 介面時傳送
    local mousePosition = UIS:GetMouseLocation()
    local guiObjects = playerGui:GetGuiObjectsAtPosition(
        mousePosition.X, mousePosition.Y
    )

    for _, object in ipairs(guiObjects) do
        if object:IsDescendantOf(main) then
            return
        end
    end

    local character, humanoid, root = getCharacterParts()
    if not character or not humanoid or not root then return end
    if humanoid.Health <= 0 then return end

    local hit = mouse.Hit
    if not hit then return end

    local destination = hit.Position + Vector3.new(0, 3, 0)
    character:PivotTo(CFrame.new(destination))
end))

